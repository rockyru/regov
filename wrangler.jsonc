{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regov",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // regov.app moved to the VPS on Oct 27 2026 (see scripts/vps/deploy.sh). No custom domains here,
  // so a stray `wrangler deploy` cannot take the domain back from the server.
  "routes": [],
  "containers": [
    { "class_name": "RegovContainer", "image": "./Dockerfile", "max_instances": 1, "instance_type": "standard-2" }
  ],
  "durable_objects": { "bindings": [{ "name": "REGOV", "class_name": "RegovContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RegovContainer"] }],
  "vars": { "R2_BUCKET": "regov-jobs", "SUBMISSIONS": "open" }
}
