MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
# Other models (docs/models.md): SAM_MODEL=sam-3.1  IMAGE_MODEL=muse-image-1.0
# MODEL_CACHE=replay rebuilds a saved job from its recorded model answers only (no key, no calls).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCOUNT_ID=
R2_BUCKET=
# Optional capacity limits (see README): RUN_CONCURRENCY=2 RUN_QUEUE_MAX=8 RUN_RATE_LIMIT=3 RUN_RATE_WINDOW_MIN=10 RUN_DEDUPE_HOURS=24

# Operator page /admin?token=... and /api/rerun (reruns and design checks that skip public limits).
# At least 16 characters; leave empty to disable. In production: npx wrangler secret put ADMIN_TOKEN
ADMIN_TOKEN=

# Feedback box (src/lib/feedback.ts): comments are always stored under jobs/.feedback and shown on /admin.
# To also email them, onboard a domain to Cloudflare Email Sending and create an API token with Email Sending permission.
FEEDBACK_TO=
FEEDBACK_FROM=
CLOUDFLARE_EMAIL_TOKEN=

# Cloudflare Turnstile on the feedback and Reimagine forms (src/lib/turnstile.ts). Leave empty to turn it off.
# TURNSTILE_HOSTNAMES lists the hosts allowed to issue tokens: your domain in production, localhost,127.0.0.1 locally.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

# Your GitHub Sponsors page (https://github.com/sponsors/<you>). Unset hides /support and its links. Read at build time.
SPONSOR_URL=
